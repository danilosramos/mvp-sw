rules_version = '2';

// Regras do Fechou. Cole em: Firebase > Firestore Database > Regras > Publicar.
// - Jogos e confirmações: qualquer um lê (é o que o convite mostra).
// - Qualquer pessoa logada marca o próprio jogo; quem marcou (ou o time) apaga.
// - Jogador sem conta: só cria a própria confirmação, num jogo que existe.
// - Lista de jogadores (com WhatsApp) e convites: só o time lê e escreve.
// - Perfil de jogador: só a própria pessoa e o time leem (tem WhatsApp).
// - Time = conta com um documento em /admins/{uid}. A pessoa entra no time com o código do time.
service cloud.firestore {
  match /databases/{database}/documents {

    function ehEquipe() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function ehDonoDoJogo(jogoId) {
      return request.auth != null
        && get(/databases/$(database)/documents/jogos/$(jogoId)).data.donoUid == request.auth.uid;
    }

    function jogoDeJogadorValido() {
      return request.auth != null
        && request.resource.data.keys().hasOnly(['arena', 'esporte', 'nivel', 'quando', 'total', 'vagas', 'valor', 'situacao', 'teste', 'criadoEm', 'donoUid', 'donoNome', 'donoZap', 'origem', 'visibilidade', 'cidade', 'cidadeChave'])
        && request.resource.data.donoUid == request.auth.uid
        && request.resource.data.origem == 'jogador'
        && request.resource.data.teste == false
        && request.resource.data.arena is string
        && request.resource.data.arena.size() >= 2
        && request.resource.data.arena.size() <= 80
        && request.resource.data.esporte is string
        && request.resource.data.esporte.size() <= 40
        && request.resource.data.nivel is number
        && request.resource.data.quando is string
        && request.resource.data.quando.size() <= 20
        && request.resource.data.total is number
        && request.resource.data.total >= 2
        && request.resource.data.total <= 30
        && request.resource.data.vagas is number
        && request.resource.data.vagas >= 1
        && request.resource.data.vagas <= request.resource.data.total
        && (request.resource.data.valor == null || request.resource.data.valor is number)
        && request.resource.data.situacao in ['vago', 'cancelar']
        && request.resource.data.donoNome is string
        && request.resource.data.donoNome.size() <= 60
        && request.resource.data.donoZap is string
        && request.resource.data.donoZap.size() <= 15
        && request.resource.data.get('visibilidade', 'privado') in ['publico', 'privado']
        && request.resource.data.get('cidade', '') is string
        && request.resource.data.get('cidade', '').size() <= 60
        && request.resource.data.get('cidadeChave', '') is string
        && request.resource.data.get('cidadeChave', '').size() <= 60;
    }

    function perfilValido(uid) {
      return request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nome', 'esportes', 'nivel', 'horarios', 'cidade', 'cidadeChave', 'whatsapp', 'aceitaConvites', 'plano', 'criadoEm', 'atualizadoEm'])
        && request.resource.data.nome is string
        && request.resource.data.nome.size() <= 60
        && request.resource.data.esportes is list
        && request.resource.data.esportes.size() <= 10
        && request.resource.data.nivel is number
        && request.resource.data.horarios is list
        && request.resource.data.horarios.size() <= 10
        && request.resource.data.cidade is string
        && request.resource.data.cidade.size() <= 60
        && request.resource.data.cidadeChave is string
        && request.resource.data.cidadeChave.size() <= 60
        && request.resource.data.whatsapp is string
        && request.resource.data.whatsapp.size() <= 15
        && request.resource.data.aceitaConvites is bool
        && request.resource.data.plano == 'free';
    }

    function confirmacaoPublicaValida() {
      return request.resource.data.keys().hasOnly(['jogoId', 'nome', 'via', 'criadoEm', 'uid'])
        && request.resource.data.keys().hasAll(['jogoId', 'nome', 'via', 'criadoEm'])
        && request.resource.data.via == 'link'
        && request.resource.data.nome is string
        && request.resource.data.nome.size() >= 2
        && request.resource.data.nome.size() <= 40
        && request.resource.data.jogoId is string
        && request.resource.data.jogoId.size() <= 40
        && request.resource.data.criadoEm is number
        && (!('uid' in request.resource.data) || (request.auth != null && request.resource.data.uid == request.auth.uid))
        && exists(/databases/$(database)/documents/jogos/$(request.resource.data.jogoId));
    }

    // Quem marcou o jogo adiciona quem confirmou pelo WhatsApp.
    function confirmacaoDoDonoValida() {
      return request.resource.data.keys().hasOnly(['jogoId', 'nome', 'via', 'criadoEm'])
        && request.resource.data.via == 'whatsapp'
        && request.resource.data.nome is string
        && request.resource.data.nome.size() >= 2
        && request.resource.data.nome.size() <= 40
        && request.resource.data.jogoId is string
        && ehDonoDoJogo(request.resource.data.jogoId);
    }

    // Entrar no time: a própria pessoa cria admins/{uid} com o código do time certo.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nome', 'codigo', 'criadoEm'])
        && request.resource.data.nome is string
        && request.resource.data.nome.size() <= 60
        && request.resource.data.codigo is string
        && exists(/databases/$(database)/documents/config/equipe)
        && request.resource.data.codigo == get(/databases/$(database)/documents/config/equipe).data.codigo;
      allow update, delete: if false;
    }

    // Código do time: só quem já é do time lê e troca.
    match /config/{id} {
      allow read, write: if ehEquipe();
    }

    match /perfis/{uid} {
      allow read: if (request.auth != null && request.auth.uid == uid) || ehEquipe();
      allow create, update: if perfilValido(uid);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Lista de espera do Premium: cada um entra e sai da própria; o time vê o total.
    match /interesse_premium/{uid} {
      allow read: if (request.auth != null && request.auth.uid == uid) || ehEquipe();
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['plano', 'criadoEm'])
        && request.resource.data.plano == 'premium';
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /jogadores/{id} {
      allow read, write: if ehEquipe();
    }

    match /convites/{id} {
      allow read, write: if ehEquipe();
    }

    match /jogos/{id} {
      allow read: if true;
      allow create: if ehEquipe() || jogoDeJogadorValido();
      allow update: if ehEquipe();
      allow delete: if ehEquipe() || (request.auth != null && resource.data.donoUid == request.auth.uid);
    }

    match /confirmacoes/{id} {
      allow read: if true;
      allow create: if ehEquipe() || confirmacaoPublicaValida() || confirmacaoDoDonoValida();
      allow update: if ehEquipe();
      allow delete: if ehEquipe() || ehDonoDoJogo(resource.data.jogoId);
    }
  }
}
